{
  "manifest_version": 3,
  "name": "ChopHop",
  "version": "0.1.0",
  "description": "Tell an agent what matters. Share only those video moments.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
